# Salin jadi .env DI FOLDER API (di luar public_html) atau isi di Setup Node.js App.
# Jangan unggah .env ke document root web.
NODE_ENV=production
# Jika memakai CloudLinux/Passenger, PORT dapat dikelola Passenger; jangan paksa port publik.
DATABASE_URL="mysql://CPANELUSER_dbuser:CHANGE_DB_PASSWORD@localhost:3306/CPANELUSER_inpos"
JWT_SECRET=CHANGE_RANDOM_SECRET_MINIMUM_32_CHARACTERS
CSRF_SECRET=CHANGE_ANOTHER_RANDOM_SECRET_MINIMUM_32_CHARACTERS
REGISTRATION_REFERRAL_CODE=CHANGE_PRIVATE_INVITATION_CODE
# Akun awal dibuat HANYA saat seed. PIN 112233 wajib diganti login pertama.
INITIAL_SUPERADMIN_USERNAME=superinpos
INITIAL_SUPERADMIN_PIN=112233
INITIAL_STORE_SLUG=inpos
INITIAL_STORE_NAME=INPOS
INITIAL_OWNER_USERNAME=inpos
INITIAL_OWNER_PIN=112233
SUBSCRIPTION_PRICE=75000
TAX_LICENSE_PRICE=50000
TRIAL_DAYS=60
QRIS_IMAGE_URL=
