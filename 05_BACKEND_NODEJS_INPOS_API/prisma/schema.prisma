generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  EMPLOYEE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum InvoiceType {
  SUBSCRIPTION
  TAX
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Tenant {
  id                 String @id @default(cuid())
  slug               String @unique @db.VarChar(60)
  name               String @db.VarChar(130)
  address            String? @db.VarChar(255)
  whatsapp           String? @db.VarChar(25)
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime
  subscriptionEndsAt DateTime?
  taxActiveUntil     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  users              User[]
  products           Product[]
  sales              Sale[]
  purchases          Purchase[]
  orders             StoreOrder[]
  invoices           Invoice[]
}

model User {
  id           String @id @default(cuid())
  tenantId     String?
  username     String @db.VarChar(80)
  displayName  String @db.VarChar(130)
  passwordHash String @db.VarChar(255)
  role         UserRole
  active       Boolean @default(true)
  mustChangePin Boolean @default(false)
  createdAt    DateTime @default(now())
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, username])
  @@index([role])
  @@index([tenantId, role])
}

model Product {
  id          String @id @default(cuid())
  tenantId    String
  name        String @db.VarChar(150)
  sku         String @db.VarChar(80)
  category    String @default("Umum") @db.VarChar(80)
  baseUnit    String @default("pcs") @db.VarChar(32)
  packUnit    String? @db.VarChar(32)
  packFactor  Int @default(1)
  price       Int
  cost        Int @default(0)
  stock       Int @default(0)
  minStock    Int @default(0)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  saleLines   SaleLine[]
  purchaseLines PurchaseLine[]
  orderLines  StoreOrderLine[]
  @@unique([tenantId, sku])
  @@index([tenantId, active])
  @@index([tenantId, name, id])
  @@index([tenantId, active, name])
}

model Sale {
  id              String @id @default(cuid())
  tenantId        String
  requestId       String @db.VarChar(90)
  total           Int
  createdAt       DateTime @default(now())
  tenant          Tenant @relation(fields: [tenantId], references: [id])
  lines           SaleLine[]
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
}

model SaleLine {
  id        String @id @default(cuid())
  saleId    String
  productId String
  qty       Int
  unitPrice Int
  subtotal  Int
  sale      Sale @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Purchase {
  id        String @id @default(cuid())
  tenantId  String
  requestId String @db.VarChar(90)
  total     Int
  createdAt DateTime @default(now())
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  lines     PurchaseLine[]
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
}

model PurchaseLine {
  id        String @id @default(cuid())
  purchaseId String
  productId String
  qty       Int
  unitCost  Int
  subtotal  Int
  purchase  Purchase @relation(fields: [purchaseId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model StoreOrder {
  id          String @id @default(cuid())
  tenantId    String
  requestId   String? @db.VarChar(90)
  customer    String @db.VarChar(130)
  phone       String @db.VarChar(25)
  note        String? @db.VarChar(400)
  status      OrderStatus @default(PENDING)
  total       Int
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  items       StoreOrderLine[]
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@unique([tenantId, requestId])
}

model StoreOrderLine {
  id        String @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  unitPrice Int
  subtotal  Int
  order     StoreOrder @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Invoice {
  id         String @id @default(cuid())
  tenantId   String
  type       InvoiceType
  months     Int @default(1)
  amount     Int
  uniqueCode Int
  total      Int
  status     InvoiceStatus @default(PENDING)
  createdAt  DateTime @default(now())
  handledAt  DateTime?
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  codeLock   PaymentCodeLock?
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model PaymentCodeLock {
  code      Int @id
  invoiceId String @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                   Int @id @default(1)
  subscriptionPrice    Int
  taxLicensePrice      Int
  trialDays            Int @default(60)
  qrisImageUrl         String? @db.VarChar(500)
  updatedAt            DateTime @updatedAt
}
