{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "lib": ["ES2022", "DOM"], "moduleResolution": "node",
    "outDir": "./dist", "sourceMap": false, "declaration": false,
    "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "strict": true, "skipLibCheck": true, "noImplicitAny": true, "forceConsistentCasingInFileNames": true
  }, "include": ["src/**/*.ts"], "exclude": ["node_modules", "dist"]
}
