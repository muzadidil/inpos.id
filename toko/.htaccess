Options -Indexes
DirectoryIndex index.php
RewriteEngine On
<FilesMatch "^(?:inpos-core\.php|page-template\.html|index\.php\.bak)$">
  Require all denied
</FilesMatch>
# Disallow remote inspection of private supporting files. PHP can still include them.
<Files "page-template.html">
  Require all denied
</Files>
RewriteRule ^api/(.*)$ proxy.php?__path=api/$1 [QSA,L]
RewriteRule ^katalog/([a-z0-9-]{1,40})\.json$ proxy.php?__path=katalog/$1.json [QSA,L]
RewriteRule ^$ index.php [L]
RewriteRule ^([a-z0-9-]{1,40})/?$ index.php [L]
<FilesMatch "^(?:\.env|composer\.json|package\.json|README.*|.*\.md)$">
  Require all denied
</FilesMatch>
